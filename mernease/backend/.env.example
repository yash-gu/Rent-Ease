# Database connection URL (PostgreSQL)
DATABASE_URL=postgresql://username:password@localhost:5432/rentease

# Port for the Express.js API backend
PORT=5001

# Secret key for signing JSON Web Tokens (must be a strong, random key in production)
JWT_SECRET=your_jwt_secret_key_here

# Runtime environment (development or production)
NODE_ENV=development

# Allowed frontend Origin for CORS configuration
FRONTEND_URL=http://localhost:3000

# Minimum severity log level for Winston logger (error, warn, info, debug)
LOG_LEVEL=info